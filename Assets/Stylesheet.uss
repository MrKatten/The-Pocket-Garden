.unity-button {
    width: 460px;
    height: 150px;
    justify-content: flex-start;
    align-self: center;
    align-content: flex-start;
    align-items: stretch;
    flex-direction: column;
    top: 850px;
    margin-top: 25px;
    margin-right: 25px;
    margin-bottom: 25px;
    margin-left: 25px;
    font-size: 80px;
    -unity-font-style: bold;
    text-overflow: clip;
    white-space: normal;
    background-color: rgba(204, 204, 204, 0);
    background-image: url("project://database/Assets/Sprites/Button.png?fileID=2800000&guid=3052f8f8b56bc794ab48057349905f8a&type=3#Button");
    background-size: 115% 180%;
    color: rgb(234, 191, 132);
    -unity-text-outline-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: rgb(255, 255, 255);
    border-left-color: rgba(255, 255, 255, 0);
    border-right-color: rgba(255, 255, 255, 0);
    border-top-color: rgba(255, 255, 255, 0);
    border-bottom-color: rgba(255, 255, 255, 0);
}
